FINDUS_PORT=8080
FINDUS_DATA_DIR=./data
FINDUS_BASE_URL=http://localhost:8080
FINDUS_JWT_SECRET=
# Defaults to true when FINDUS_BASE_URL starts with https://
FINDUS_COOKIE_SECURE=
# true only behind a reverse proxy that sets X-Forwarded-For (needed for per-client rate limits)
FINDUS_TRUST_PROXY=false
# Needed to create the first account; if empty, a one-time setup link is written to the log
FINDUS_SETUP_TOKEN=
FINDUS_LOG_LEVEL=info
# Human-readable logs by default. Set FINDUS_LOG_FORMAT=json for structured JSON (e.g. log aggregation).
FINDUS_LOG_FORMAT=text

